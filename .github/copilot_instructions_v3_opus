from exercise_database import CANONICAL_EXERCISES

def build_warmup_pool(user_context: dict, focus_intent: dict) -> List[str]:
    """
    Build pool of warm-up exercises (cardio + activation)
    
    Args:
        user_context: User profile and constraints
        focus_intent: Detected workout focus
    
    Returns:
        List of exercise IDs suitable for warm-up
    """
    pool = []
    
    # Get user equipment
    available_equipment = user_context.get('available_equipment', [
        'bodyweight', 'dumbbells', 'barbell', 'cable', 'machine'
    ])
    
    # Get user injuries
    injuries = user_context.get('active_injuries', [])
    
    # Add cardio warm-ups based on equipment
    for ex_id, exercise in CANONICAL_EXERCISES.items():
        if not exercise.isCardioWarmup:
            continue
        
        # Check equipment availability
        if not any(eq in available_equipment for eq in exercise.equipment_required):
            continue
        
        # Check injury constraints
        is_safe = True
        for injury in injuries:
            if injury.upper() in [i.name for i in exercise.injury_contraindications]:
                is_safe = False
                break
        
        if is_safe:
            pool.append(ex_id)
    
    # Add activation exercises based on focus
    focus_type = focus_intent.get('detected_type', '')
    
    for ex_id, exercise in CANONICAL_EXERCISES.items():
        if not exercise.isActivation:
            continue
        
        # Check equipment availability
        if not any(eq in available_equipment for eq in exercise.equipment_required):
            continue
        
        # Check injury constraints
        is_safe = True
        for injury in injuries:
            if injury.upper() in [i.name for i in exercise.injury_contraindications]:
                is_safe = False
                break
        
        if not is_safe:
            continue
        
        # Filter by focus relevance
        if focus_type in ['chest', 'push']:
            if any(m in ['chest_activation', 'serratus', 'rotator_cuff', 'chest', 'triceps'] 
                   for m in exercise.primary_muscles):
                pool.append(ex_id)
        elif focus_type in ['back', 'pull']:
            if any(m in ['lats', 'lower_traps', 'rear_delts', 'rhomboids', 'traps']
                   for m in exercise.primary_muscles):
                pool.append(ex_id)
        elif focus_type in ['legs', 'lower']:
            if any(m in ['glutes', 'hip_stabilizers', 'adductors', 'tibialis', 'calves', 'hamstrings']
                   for m in exercise.primary_muscles):
                pool.append(ex_id)
        elif focus_type == 'shoulders':
            if any(m in ['rotator_cuff', 'rear_delts', 'shoulders']
                   for m in exercise.primary_muscles):
                pool.append(ex_id)
    
    return list(set(pool))[:12]  # Cap at 12 for performance

