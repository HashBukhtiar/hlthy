        """Find brand machines by partial name match."""
        name_lower = name.lower()
        matches = []
        
        for key, info in self.brand_mappings.items():
            if (name_lower in info['display_name'].lower() or
                name_lower in key.replace('_', ' ')):
                matches.append((key, info))
        
        return matches
    
    def get_canonical_for_brand(self, brand_machine_key: str) -> Optional[str]:
        """Get preferred canonical exercise ID for brand machine."""
        machine = self.brand_mappings.get(brand_machine_key)
        return machine['preferred_id'] if machine else None
    
    def get_alternatives_for_brand(self, brand_machine_key: str) -> List[str]:
        """Get alternative canonical exercise IDs for brand machine."""
        machine = self.brand_mappings.get(brand_machine_key)
        return machine['canonical_ids'] if machine else []
    
    def get_pattern_exercises(self, pattern: str) -> List[str]:
        """Get exercises for a movement pattern."""
        return self.pattern_mappings.get(pattern, [])
    
    def resolve_to_canonical(self, exercise_name: str) -> Tuple[Optional[str], List[str]]:
        """
        Resolve any exercise name to canonical ID.
        Returns (preferred_id, alternatives).
        """
        # Check if it's a brand machine
        matches = self.find_by_name(exercise_name)
        if matches:
            # Return first match
            key, info = matches[0]
            return info['preferred_id'], info['canonical_ids']
        
        # Check patterns
        for pattern, exercises in self.pattern_mappings.items():
            if pattern in exercise_name.lower():
                return exercises[0] if exercises else None, exercises
        
        return None, []

