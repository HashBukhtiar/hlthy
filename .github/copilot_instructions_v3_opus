class InterviewState:
    """Manages interview flow state."""
    
    def __init__(self):
        self.current_question_index = 0
        self.responses = {}
        self.context = {}
        self.questions = self._get_interview_questions()
    
    def _get_interview_questions(self) -> List[Dict]:
        """Get personalized interview questions."""
        base_questions = [
            {
                'id': 'goal',
                'question': "What's your main training goal right now?",
                'options': ['Build muscle (hypertrophy)', 'Get stronger', 'Improve endurance', 'General fitness'],
                'type': 'choice'
            },
            {
                'id': 'time',
                'question': "How much time do you have for today's workout?",
                'options': ['30 minutes', '45 minutes', '60 minutes', '75+ minutes'],
                'type': 'choice'
            },
            {
                'id': 'equipment',
                'question': "What equipment do you have access to? (You can list specific brands like Life Fitness, Hammer Strength, etc.)",
                'type': 'text',
                'follow_up': "Any specific machines or equipment you prefer to use or avoid?"
            },
            {
                'id': 'soreness',
                'question': "Any areas feeling sore or fatigued today?",
                'type': 'text',
                'optional': True
            },
            {
                'id': 'injuries',
                'question': "Any current injuries or areas to be careful with?",
                'type': 'text',
                'optional': True
            }
        ]
        
        # Add context-specific questions if muscles were mentioned
        if self.context.get('mentioned_muscles'):
            muscles = ', '.join(self.context['mentioned_muscles'])
            base_questions.insert(1, {
                'id': 'focus_confirm',
                'question': f"I see you want to work {muscles}. Is this your main focus, or part of a larger workout?",
                'options': ['Main focus', 'Part of full body', 'Part of split routine'],
                'type': 'choice'
            })
        
        return base_questions
    
    def get_next_question(self) -> Optional[Dict]:
        """Get next question in sequence."""
        if self.current_question_index < len(self.questions):
            return self.questions[self.current_question_index]
        return None
    
    def record_response(self, question_id: str, response: str) -> None:
        """Record user response."""
        self.responses[question_id] = response
        self.current_question_index += 1
    
    def is_complete(self) -> bool:
        """Check if interview is complete."""
        required_questions = [q for q in self.questions if not q.get('optional')]
        required_ids = [q['id'] for q in required_questions]
        return all(qid in self.responses for qid in required_ids)
    
    def get_summary(self) -> Dict:
        """Get interview summary for profile storage."""
        return {
            'responses': self.responses,
            'context': self.context,
            'timestamp': datetime.now().isoformat()
        }

