    whitelist: List[str], 
    warmup_pool: List[str],
    cooldown_pool: List[str],
    slot_template: Dict,
    user_context: Dict
) -> Dict:
    """
    Compose complete workout with proper warm-up and cool-down segments.
    """
    from exercise_database import get_exercise_by_id
    import random
    
    workout = {
        'focus': focus,
        'warmup': [],
        'main': [],
        'accessory': [],
        'cooldown': []
    }
    
    # Track used exercises to prevent duplication
    used_exercises = set()
    
    # 1. Build warm-up (1 cardio + 1-2 activation)
    cardio_options = [e for e in warmup_pool if get_exercise_by_id(e).get('isCardioWarmup', False)]
    activation_options = [e for e in warmup_pool if get_exercise_by_id(e).get('isActivation', False)]
    
    if cardio_options:
        cardio_choice = random.choice(cardio_options)
        workout['warmup'].append({
            'exercise_id': cardio_choice,
            'sets': 1,
            'reps': '3-5 min',
            'rpe': 4,
            'role': 'cardio_warmup'
        })
        used_exercises.add(cardio_choice)
    
    # Add 1-2 activation exercises based on focus
    activation_count = min(2, len(activation_options))
    for act_exercise in random.sample(activation_options, min(activation_count, len(activation_options))):
        if act_exercise not in used_exercises:
            workout['warmup'].append({
                'exercise_id': act_exercise,
                'sets': 2,
                'reps': '10-15',
                'rpe': 5,
                'role': 'activation'
            })
            used_exercises.add(act_exercise)
    
    # 2. Build main workout (existing logic)
    main_exercises = [e for e in whitelist if e not in used_exercises]
    
    # Use slot template to guide main workout
    if slot_template and 'patterns' in slot_template:
        for pattern in slot_template['patterns']:
            pattern_exercises = [e for e in main_exercises 
                                if _matches_pattern(e, pattern) and e not in used_exercises]
            if pattern_exercises:
                chosen = pattern_exercises[0]  # Could be more sophisticated
                workout['main'].append({
                    'exercise_id': chosen,
                    'sets': 4,
                    'reps': '8-12',
                    'rpe': 7,
                    'role': 'primary'
                })
                used_exercises.add(chosen)
                main_exercises.remove(chosen)
    
    # 3. Build accessory work
    accessory_count = min(3, len(main_exercises))
    for acc_exercise in main_exercises[:accessory_count]:
        if acc_exercise not in used_exercises:
            workout['accessory'].append({
                'exercise_id': acc_exercise,
                'sets': 3,
                'reps': '12-15',
                'rpe': 6,
                'role': 'accessory'
            })
            used_exercises.add(acc_exercise)
    
    # 4. Build cool-down (1-2 mobility/stretch)
    cooldown_options = [e for e in cooldown_pool 
                       if e not in used_exercises and 
                       (get_exercise_by_id(e).get('isMobility', False) or 
                        get_exercise_by_id(e).get('isStretch', False))]
    
    # Prioritize stretches for worked muscle groups
    focus_muscles = _get_focus_muscles(focus)
    relevant_cooldown = [e for e in cooldown_options 
                        if _targets_muscles(e, focus_muscles)]
    
    if not relevant_cooldown:
        relevant_cooldown = cooldown_options
    
    cooldown_count = min(2, len(relevant_cooldown))
    for cool_exercise in random.sample(relevant_cooldown, min(cooldown_count, len(relevant_cooldown))):
        if cool_exercise not in used_exercises:
