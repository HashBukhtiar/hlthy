Task C: Exercise Alias Resolver
"""Exercise alias resolver for mapping various names to canonical IDs."""

import difflib
from typing import List, Dict, Optional, Tuple
from exercise_database import get_all_exercises, get_exercise_by_id
from equipment_catalog import equipment_catalog

class ExerciseAliasResolver:
    """Resolves exercise names and aliases to canonical exercise IDs."""
    
    def __init__(self):
        self.index = self._build_index()
        self.confidence_threshold = 0.75
    
    def _build_index(self) -> Dict[str, str]:
        """Build index of all exercise names to canonical IDs."""
        index = {}
        
        # Get all exercises from database
        all_exercises = get_all_exercises()
        
        for exercise_id, exercise_data in all_exercises.items():
            # Add main ID
            index[exercise_id.lower()] = exercise_id
            
            # Add display name
            if 'display_name' in exercise_data:
                index[exercise_data['display_name'].lower()] = exercise_id
            
            # Add common names
            if 'common_names' in exercise_data:
                for name in exercise_data['common_names']:
                    index[name.lower()] = exercise_id
        
        # Add brand machine names
        for key, info in equipment_catalog.brand_mappings.items():
            # Map brand names to preferred canonical ID
            index[info['display_name'].lower()] = info['preferred_id']
            index[key.replace('_', ' ')] = info['preferred_id']
        
        return index
    
    def resolve(self, exercise_name: str) -> Tuple[Optional[str], List[str], float]:
        """
        Resolve exercise name to canonical ID.
        Returns (canonical_id, alternatives, confidence).
        """
        name_lower = exercise_name.lower().strip()
        
        # Exact match
        if name_lower in self.index:
            return self.index[name_lower], [], 1.0
        
        # Try brand catalog first
        canonical, alternatives = equipment_catalog.resolve_to_canonical(exercise_name)
        if canonical:
            return canonical, alternatives, 0.9
        
        # Fuzzy match
        matches = difflib.get_close_matches(
            name_lower, 
            self.index.keys(), 
            n=3, 
            cutoff=self.confidence_threshold
        )
        
        if matches:
            # Return best match and alternatives
            best_match = self.index[matches[0]]
            alternatives = [self.index[m] for m in matches[1:] if m != matches[0]]
            confidence = difflib.SequenceMatcher(None, name_lower, matches[0]).ratio()
            return best_match, alternatives, confidence
        
        return None, [], 0.0
    
    def get_suggestions(self, exercise_name: str, max_suggestions: int = 3) -> List[Dict]:
        """
        Get top suggestions for an unresolved exercise name.
        Returns list of {exercise_id, display_name, confidence}.
        """
        name_lower = exercise_name.lower().strip()
        
        # Get close matches with lower threshold
        matches = difflib.get_close_matches(
            name_lower, 
            self.index.keys(), 
            n=max_suggestions, 
            cutoff=0.5
        )
        
        suggestions = []
        for match in matches:
            exercise_id = self.index[match]
            exercise_data = get_exercise_by_id(exercise_id)
            if exercise_data:
                confidence = difflib.SequenceMatcher(None, name_lower, match).ratio()
                suggestions.append({
                    'exercise_id': exercise_id,
                    'display_name': exercise_data.get('display_name', exercise_id),
                    'confidence': confidence
                })
        
        return suggestions
    
    def is_valid_exercise(self, exercise_name: str) -> bool:
        """Check if exercise name can be resolved to a valid ID."""
        canonical_id, _, confidence = self.resolve(exercise_name)
        return canonical_id is not None and confidence >= self.confidence_threshold

