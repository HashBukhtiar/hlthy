    """Handle user permission response."""
    if 'yes' in permission.lower() or 'do it' in permission.lower():
        # Save to profile
        state = interview_sessions[user_id]
        summary = state.get_summary()
        
        profile_update = {
            'last_interview_date': datetime.now().isoformat(),
            'training_goal': summary['responses'].get('goal'),
            'preferred_session_length': summary['responses'].get('time'),
            'preferred_equipment': summary['responses'].get('equipment'),
            'current_soreness': summary['responses'].get('soreness'),
            'current_injuries': summary['responses'].get('injuries')
        }
        
        update_user_profile(user_id, profile_update)
        
        # Clean up session
        del interview_sessions[user_id]
        
        return {
            'type': 'ready_to_plan',
            'message': "Perfect! Building your workout now...",
            'context': summary
        }
    
    elif 'change' in permission.lower():
