        'shoulders': ['shoulder', 'delt'],
        'arms': ['arm', 'bicep', 'tricep'],
        'legs': ['leg', 'quad', 'hamstring', 'glute', 'calf'],
        'core': ['core', 'ab', 'oblique']
    }
    
    for muscle, keywords in muscle_keywords.items():
        if any(kw in text_lower for kw in keywords):
            context['mentioned_muscles'].append(muscle)
    
    # Extract goals
    goal_keywords = {
