                   for m in exercise.primary_muscles):
                prioritized_pool.insert(0, ex_id)
            else:
                prioritized_pool.append(ex_id)
        elif focus_type in ['legs', 'lower']:
            if any(m in ['hip_flexors', 'glutes', 'hamstrings', 'quadriceps', 'calves']
