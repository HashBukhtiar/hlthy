class InterviewSession:
    """Manages the interview flow for workout planning"""
    
    def __init__(self, user_id: str):
        self.user_id = user_id
        self.state = 'initial'
        self.answers = {}
        self.questions_asked = []
        self.current_question = None
        
    def start_interview(self, initial_request: str) -> Dict:
        """Start the interview process"""
        self.state = 'interviewing'
        self.initial_request = initial_request
        
        # First question based on context
        if 'back' in initial_request.lower():
            self.current_question = {
                'type': 'goal',
                'text': "I can help you build your back! What's your main goal - building muscle size (hypertrophy), increasing strength, or improving endurance?",
                'options': ['hypertrophy', 'strength', 'endurance']
            }
        elif 'chest' in initial_request.lower():
            self.current_question = {
                'type': 'goal',
                'text': "Let's create a chest workout! Are you looking to build mass, increase your bench press strength, or improve muscular endurance?",
                'options': ['hypertrophy', 'strength', 'endurance']
            }
        else:
            self.current_question = {
                'type': 'goal',
                'text': "What's your primary training goal - building muscle (hypertrophy), getting stronger, or improving endurance?",
                'options': ['hypertrophy', 'strength', 'endurance']
            }
        
        self.questions_asked.append('goal')
        return {
            'status': 'interview_started',
            'question': self.current_question,
            'progress': f"1/{self._total_questions()}"
        }
    
    def collect_answer(self, answer: str) -> Dict:
        """Process an answer and return next question or completion"""
        # Store the answer
        question_type = self.current_question['type']
        self.answers[question_type] = answer.lower()
        
        # Determine next question
        next_question = self._get_next_question()
        
        if next_question:
            self.current_question = next_question
            self.questions_asked.append(next_question['type'])
            return {
                'status': 'question',
                'question': next_question,
                'progress': f"{len(self.questions_asked)}/{self._total_questions()}"
            }
        else:
            # All questions answered, ask for confirmation
            return self.finalize_interview()
    
    def _get_next_question(self) -> Optional[Dict]:
        """Get the next question based on what's been asked"""
        
        if 'available_time' not in self.answers:
            return {
                'type': 'available_time',
                'text': "How much time do you typically have for your workouts?",
                'options': ['30 minutes', '45 minutes', '60 minutes', '90+ minutes']
            }
        
        if 'equipment_access' not in self.answers:
            return {
                'type': 'equipment_access',
                'text': "What equipment do you have access to? I can work with commercial gym equipment (Life Fitness, Hammer Strength, etc.), home gym setup, or just dumbbells and bands.",
                'options': ['commercial gym', 'home gym', 'minimal equipment']
            }
        
        if 'equipment_access' in self.answers and self.answers['equipment_access'] == 'commercial gym':
            if 'specific_machines' not in self.answers:
                focus = detect_focus(self.initial_request)
                from exercise_alias_resolver import get_equipment_for_workout
                suggestions = get_equipment_for_workout(focus.get('detected_type', 'general'))[:5]
                
                return {
                    'type': 'specific_machines',
                    'text': f"Do you have access to these machines at your gym? {', '.join(suggestions)}",
                    'options': ['yes, all of them', 'some of them', 'none/not sure']
                }
        
        if 'injuries' not in self.answers:
            return {
                'type': 'injuries',
                'text': "Do you have any current injuries or areas that are sore/need to be careful with?",
                'options': ['no injuries', 'shoulder', 'lower back', 'knee', 'elbow', 'other']
            }
        
        if 'session_preference' not in self.answers:
            return {
                'type': 'session_preference',
                'text': "What training style do you prefer for this workout?",
                'options': ['straight sets', 'supersets', 'circuit style', 'mix it up']
            }
        
        return None
    
    def finalize_interview(self) -> Dict:
        """Complete the interview and ask for confirmation"""
        self.state = 'confirming'
        
        summary = f"""Based on what you've told me:
- Goal: {self.answers.get('goal', 'not specified')}
- Time available: {self.answers.get('available_time', 'not specified')}
- Equipment: {self.answers.get('equipment_access', 'not specified')}
- Injuries/concerns: {self.answers.get('injuries', 'none')}
- Training style: {self.answers.get('session_preference', 'not specified')}

Ready for me to create your personalized workout?"""
        
        return {
            'status': 'confirmation_needed',
            'summary': summary,
            'question': {
                'type': 'confirmation',
                'text': "Should I build your workout now?",
                'options': ['yes, create it', 'no, let me change something']
            }
        }
    
    def _total_questions(self) -> int:
        """Get total number of questions for progress tracking"""
        return 5  # goal, time, equipment, injuries, style
    
    def save_to_profile(self):
        """Save interview answers to user profile"""
        profile_data = {
            'workout_goal': self.answers.get('goal'),
            'available_time': self.answers.get('available_time'),
            'equipment_access': self.answers.get('equipment_access'),
            'active_injuries': [self.answers.get('injuries')] if self.answers.get('injuries') != 'no injuries' else [],
            'session_preference': self.answers.get('session_preference'),
            'last_interview_date': datetime.now().isoformat(),
            'specific_machines': self.answers.get('specific_machines', [])
        }
        update_user_profile(self.user_id, profile_data)

# Global interview sessions
active_interviews = {}

def handle_workout_request(user_id: str, request_text: str) -> Dict:
    """
    Main entry point for workout requests with interview flow
    
    Returns appropriate response based on request type and user context
    """
    # Check for nonsense
    if is_nonsense_or_unknown(request_text):
        return {
            'type': 'clarification_needed',
            'message': "I'm not sure what you're asking for. I can help you create workouts for specific muscle groups like chest, back, legs, or create push/pull/full-body routines. What would you like to train?",
            'suggestions': ['chest workout', 'back day', 'leg training', 'push workout', 'pull day']
        }
    
    # Get user profile
    profile = get_user_profile(user_id)
    
    # Check if interview is needed
    if needs_interview(request_text, profile):
        # Start or continue interview
        if user_id not in active_interviews:
            active_interviews[user_id] = InterviewSession(user_id)
        
        session = active_interviews[user_id]
        
        if session.state == 'initial':
            return session.start_interview(request_text)
        else:
            return {
                'type': 'interview_in_progress',
                'message': "Let's finish gathering your workout preferences first.",
                'current_question': session.current_question
            }
    
    # Direct workout generation (user has recent profile data)
    return generate_workout_plan(user_id, request_text, profile)

def handle_interview_response(user_id: str, answer: str) -> Dict:
    """Handle responses during interview flow"""
    if user_id not in active_interviews:
        return {
            'type': 'error',
            'message': "No active interview session. Please start with your workout request."
        }
    
    session = active_interviews[user_id]
    
    if session.state == 'confirming' and answer.lower() in ['yes', 'yes, create it']:
        # Save to profile and generate workout
        session.save_to_profile()
        profile = get_user_profile(user_id)
        result = generate_workout_plan(user_id, session.initial_request, profile)
        
        # Clean up session
        del active_interviews[user_id]
        return result
    
    # Continue interview
    return session.collect_answer(answer)

def generate_workout_plan(user_id: str, request_text: str, profile: Dict) -> Dict:
    """Generate the actual workout plan after interview or with existing profile"""
    
    # Detect focus
    focus_intent = detect_focus(request_text)
    
    # Build user context from profile
    user_context = {
        'experience_level': profile.get('experience_level', 'intermediate'),
        'active_injuries': profile.get('active_injuries', []),
        'available_equipment': profile.get('equipment_access', ['dumbbells', 'barbell', 'machine']),
        'workout_goal': profile.get('workout_goal', 'hypertrophy'),
        'available_time': profile.get('available_time', '60 minutes'),
        'user_id': user_id
    }
    
    # Generate whitelist
    from focus_whitelist import build_focus_whitelist
    whitelist = build_focus_whitelist(focus_intent, user_context)
    
    # Get slot template
    from focus_rules import get_slot_template
    slot_template = get_slot_template(focus_intent, user_context)
    
    # Compose segment-aware plan
    plan = compose_segment_aware_plan(focus_intent, whitelist, user_context, slot_template)
    
    # Validate plan
    validation = validate_workout_plan(plan, focus_intent, user_context)
    
    if not validation['valid']:
        # Attempt correction
        plan = correct_workout_plan(plan, validation['violations'], whitelist)
    
    # Apply progression
    from progression_tracker import fill_loads_for_plan
    plan = fill_loads_for_plan(plan, user_id)
    
    return {
        'type': 'workout_plan',
        'plan': plan,
        'metadata': {
            'focus': focus_intent['detected_type'],
            'duration': profile.get('available_time'),
            'equipment': profile.get('equipment_access'),
            'generated_at': datetime.now().isoformat()
        }
    }

def handle_exercise_clarification(user_id: str, exercise_name: str) -> Dict:
    """Handle cases where exercise name needs clarification"""
    canonical_id, suggestions = resolve_exercise_name(exercise_name)
    
    if canonical_id:
        return {
            'type': 'exercise_resolved',
            'canonical_id': canonical_id,
            'message': f"Using {CANONICAL_EXERCISES[canonical_id].display_name}"
        }
    
    if suggestions:
        return {
            'type': 'clarification_needed',
            'message': f"I'm not sure which exercise you mean by '{exercise_name}'. Did you mean one of these?",
            'suggestions': suggestions[:3]
        }
    
    return {
        'type': 'unknown_exercise',
        'message': f"I don't recognize '{exercise_name}'. Can you describe it or choose a different exercise?"
    }

