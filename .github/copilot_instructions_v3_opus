def is_nonsense_or_unknown(text: str) -> bool:
    """
    Check if request is nonsense or doesn't map to valid workout concepts.
    """
    text_lower = text.lower().strip()
    
    # Known nonsense patterns
    nonsense_patterns = [
        'toenail', 'fingernail', 'hair', 'eyebrow', 'eyelash',
        'tooth', 'teeth', 'nose', 'ear', 'tongue', 'lip',
        'kidney', 'liver', 'lung', 'brain', 'stomach', 'intestine',
        'spleen', 'pancreas', 'bladder', 'appendix'
    ]
    
    for pattern in nonsense_patterns:
        if pattern in text_lower:
            return True
    
    # Check if it contains ANY valid muscle/equipment/focus keywords
    valid_concepts = [
        'chest', 'back', 'shoulder', 'arm', 'leg', 'glute', 'ab', 'core',
        'bicep', 'tricep', 'quad', 'hamstring', 'calf', 'lat', 'delt',
        'push', 'pull', 'press', 'row', 'squat', 'deadlift', 'curl',
        'workout', 'exercise', 'train', 'build', 'strength', 'muscle',
        'hypertrophy', 'power', 'endurance', 'pump', 'gain'
    ]
    
    has_valid_concept = any(concept in text_lower for concept in valid_concepts)
    
    # If no valid concepts and short/vague
    if not has_valid_concept and len(text_lower.split()) < 10:
        return True
    
    return False

def needs_interview(text: str, user_profile: dict) -> bool:
    """
    Check if request needs interview flow for clarification.
    """
    text_lower = text.lower().strip()
    
    # Generic/vague requests that need clarification
    vague_patterns = [
        r'^build my \w+$',  # "build my back"
        r'^train \w+$',      # "train chest"  
        r'^workout$',        # just "workout"
        r'^gym day$',        # "gym day"
        r'^help me$',        # "help me"
        r'^\w+ day$',        # "leg day"
        r'^i want to \w+ my \w+$'  # "I want to build my back"
    ]
    
    import re
    is_vague = any(re.match(pattern, text_lower) for pattern in vague_patterns)
    
    if not is_vague:
        return False
    
    # Check if we have recent interview data (within 7 days)
    if user_profile:
        last_interview = user_profile.get('last_interview_date')
        if last_interview:
            from datetime import datetime, timedelta
            last_date = datetime.fromisoformat(last_interview)
            if datetime.now() - last_date < timedelta(days=7):
                # Have recent data, can proceed without interview
                return False
    
    # Check if profile has minimum required info
    required_fields = ['preferred_equipment', 'training_goal', 'session_length', 'current_injuries']
    has_required = all(user_profile.get(field) for field in required_fields)
    
    return not has_required

def extract_interview_context(text: str) -> dict:
    """Extract any context hints from the initial request."""
    text_lower = text.lower()
    
    context = {
        'mentioned_muscles': [],
        'mentioned_goals': [],
        'mentioned_equipment': []
    }
    
    # Extract muscle groups mentioned
    muscle_keywords = {
        'chest': ['chest', 'pec'],
