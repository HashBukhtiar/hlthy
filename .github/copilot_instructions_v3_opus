def resolve_exercise_names_in_plan(plan: Dict, user_id: str) -> Tuple[Dict, List[Dict]]:
    """
    Resolve any non-canonical exercise names in plan.
    Returns (resolved_plan, unresolved_items).
    """
    unresolved = []
    
    for segment in ['warmup', 'main', 'accessory', 'cooldown']:
        if segment not in plan:
            continue
            
        for exercise in plan[segment]:
            if 'exercise_name' in exercise and not exercise.get('exercise_id'):
                # Try to resolve
                canonical_id, alternatives, confidence = exercise_resolver.resolve(exercise['exercise_name'])
                
                if canonical_id and confidence >= 0.75:
                    exercise['exercise_id'] = canonical_id
                else:
                    # Need user confirmation
                    suggestions = exercise_resolver.get_suggestions(exercise['exercise_name'])
                    unresolved.append({
                        'segment': segment,
                        'original_name': exercise['exercise_name'],
                        'suggestions': suggestions
                    })
    
    return plan, unresolved

