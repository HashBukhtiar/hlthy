def validate_segment_roles(plan: Dict, focus_intent: Dict, user_context: Dict) -> List[str]:
    """
    Validate segment-specific rules for warm-up and cool-down
    
    Returns list of violations
    """
    violations = []
    
    # Extract segments
    warmup = plan.get('warmup', [])
    main = plan.get('main', [])
    cooldown = plan.get('cooldown', [])
    
    # Check warm-up requirements
    warmup_cardio_count = sum(1 for ex in warmup 
                             if ex.get('role') == 'cardio' or 
                             (ex.get('exercise_id') in CANONICAL_EXERCISES and 
                              CANONICAL_EXERCISES[ex['exercise_id']].isCardioWarmup))
    
    warmup_activation_count = sum(1 for ex in warmup 
                                 if ex.get('role') == 'activation' or
                                 (ex.get('exercise_id') in CANONICAL_EXERCISES and
                                  CANONICAL_EXERCISES[ex['exercise_id']].isActivation))
    
    if warmup_cardio_count != 1:
        violations.append(f"Warm-up must have exactly 1 cardio exercise (found {warmup_cardio_count})")
    
    if warmup_activation_count < 1:
        violations.append(f"Warm-up must have at least 1 activation exercise (found {warmup_activation_count})")
    
    # Check cool-down requirements
    cooldown_mobility_count = sum(1 for ex in cooldown 
                                 if ex.get('role') in ['mobility', 'stretch'] or
                                 (ex.get('exercise_id') in CANONICAL_EXERCISES and
                                  (CANONICAL_EXERCISES[ex['exercise_id']].isMobility or
                                   CANONICAL_EXERCISES[ex['exercise_id']].isStretch)))
    
    if cooldown_mobility_count < 1:
        violations.append(f"Cool-down must have at least 1 mobility/stretch exercise (found {cooldown_mobility_count})")
    
    # Check for no activation in cool-down
    cooldown_activation = any(ex.get('exercise_id') in CANONICAL_EXERCISES and
                             CANONICAL_EXERCISES[ex['exercise_id']].isActivation
                             for ex in cooldown)
    
    if cooldown_activation:
        violations.append("Cool-down must not contain activation exercises")
    
    # Check for no duplication between segments
    warmup_ids = {ex['exercise_id'] for ex in warmup if 'exercise_id' in ex}
    cooldown_ids = {ex['exercise_id'] for ex in cooldown if 'exercise_id' in ex}
    main_ids = {ex['exercise_id'] for ex in main if 'exercise_id' in ex}
    
    duplicates = warmup_ids & cooldown_ids
    if duplicates:
        violations.append(f"Exercises cannot be repeated between warm-up and cool-down: {duplicates}")
    
    # Check cool-down targets appropriate muscles
    if main:
        main_muscles = set()
        for ex in main:
            if ex.get('exercise_id') in CANONICAL_EXERCISES:
                main_muscles.update(CANONICAL_EXERCISES[ex['exercise_id']].primary_muscles)
        
        cooldown_muscles = set()
        for ex in cooldown:
            if ex.get('exercise_id') in CANONICAL_EXERCISES:
                cooldown_muscles.update(CANONICAL_EXERCISES[ex['exercise_id']].primary_muscles)
        
        # Calculate overlap
        if main_muscles and cooldown_muscles:
            overlap = len(main_muscles & cooldown_muscles) / len(main_muscles)
            if overlap < 0.3:  # Less than 30% overlap
                violations.append("Cool-down should target muscles used in main workout")
    
    return violations

def validate_workout_plan(plan: Dict, focus_intent: Dict, user_context: Dict) -> Dict:
    """
    Comprehensive validation including segment rules
    
    Returns validation results with violations
    """
    # First run existing validation
    validation = validate_focus_composition(plan.get('main', []), focus_intent, user_context)
    
    # Add segment validation
    segment_violations = validate_segment_roles(plan, focus_intent, user_context)
    
    if segment_violations:
        validation['valid'] = False
        validation['violations'].extend(segment_violations)
    
    # Check total volume constraints
    total_sets = (len(plan.get('warmup', [])) + 
                 sum(ex.get('sets', 3) for ex in plan.get('main', [])) +
                 len(plan.get('cooldown', [])))
    
    if total_sets > 30:
        validation['valid'] = False
        validation['violations'].append(f"Total sets ({total_sets}) exceeds maximum of 30")
    
    return validation

def correct_workout_plan(plan: Dict, violations: List[str], whitelist: List[str]) -> Dict:
    """
    Attempt to correct plan violations while maintaining segments
    
    Returns corrected plan
    """
    corrected = plan.copy()
    
    for violation in violations:
        if "Warm-up must have exactly 1 cardio" in violation:
            # Add or fix cardio in warmup
            cardio_options = [ex_id for ex_id in whitelist 
                            if ex_id in CANONICAL_EXERCISES and 
                            CANONICAL_EXERCISES[ex_id].isCardioWarmup]
            if cardio_options:
                corrected['warmup'] = [ex for ex in corrected.get('warmup', []) 
                                      if ex.get('role') != 'cardio']
                corrected['warmup'].insert(0, {
                    'exercise_id': cardio_options[0],
                    'sets': 1,
                    'reps': '3-5 min',
                    'segment': 'warmup',
                    'role': 'cardio'
                })
        
        elif "Warm-up must have at least 1 activation" in violation:
            # Add activation exercise
            activation_options = [ex_id for ex_id in whitelist 
                                if ex_id in CANONICAL_EXERCISES and 
                                CANONICAL_EXERCISES[ex_id].isActivation]
            if activation_options:
                corrected['warmup'].append({
                    'exercise_id': activation_options[0],
                    'sets': 1,
                    'reps': '10-15',
                    'segment': 'warmup',
                    'role': 'activation'
                })
        
        elif "Cool-down must have at least 1 mobility" in violation:
            # Add mobility/stretch exercise
            cooldown_options = [ex_id for ex_id in whitelist 
                              if ex_id in CANONICAL_EXERCISES and 
                              (CANONICAL_EXERCISES[ex_id].isMobility or 
                               CANONICAL_EXERCISES[ex_id].isStretch)]
            if cooldown_options:
                corrected['cooldown'] = corrected.get('cooldown', [])
                corrected['cooldown'].append({
                    'exercise_id': cooldown_options[0],
                    'sets': 1,
                    'reps': '30-60 sec',
                    'segment': 'cooldown',
                    'role': 'stretch'
                })
        
        elif "cannot be repeated between warm-up and cool-down" in violation:
            # Remove duplicates from cooldown
            warmup_ids = {ex['exercise_id'] for ex in corrected.get('warmup', [])}
            corrected['cooldown'] = [ex for ex in corrected.get('cooldown', [])
                                    if ex['exercise_id'] not in warmup_ids]
    
    return corrected

