def start_interview(user_id: str, initial_text: str) -> Dict:
    """Start interview flow for user."""
    context = extract_interview_context(initial_text)
    
    # Create new interview state
    state = InterviewState()
    state.context = context
    interview_sessions[user_id] = state
    
    # Get first question
    first_question = state.get_next_question()
    
    return {
        'type': 'interview',
        'status': 'started',
        'message': "I'd love to help you build the perfect workout! Let me ask you a few quick questions first.",
        'question': first_question,
        'progress': f"Question 1 of {len(state.questions)}"
    }

def continue_interview(user_id: str, response: str) -> Dict:
    """Continue interview with user response."""
    if user_id not in interview_sessions:
        return {
            'type': 'error',
            'message': "No active interview found. Please start a new request."
        }
    
    state = interview_sessions[user_id]
    current_question = state.questions[state.current_question_index - 1] if state.current_question_index > 0 else None
    
    if current_question:
        state.record_response(current_question['id'], response)
    
    # Check if complete
    if state.is_complete():
        return finalize_interview(user_id)
    
    # Get next question
    next_question = state.get_next_question()
    if next_question:
        return {
            'type': 'interview',
            'status': 'in_progress',
            'question': next_question,
            'progress': f"Question {state.current_question_index + 1} of {len(state.questions)}"
        }
    
    return finalize_interview(user_id)

def finalize_interview(user_id: str) -> Dict:
    """Finalize interview and ask permission to build workout."""
    if user_id not in interview_sessions:
        return {
            'type': 'error',
            'message': "No active interview found."
        }
    
    state = interview_sessions[user_id]
    summary = state.get_summary()
    
    # Build summary message
    summary_text = "Great! Based on what you've told me:\n"
    if 'goal' in summary['responses']:
        summary_text += f"• Goal: {summary['responses']['goal']}\n"
    if 'time' in summary['responses']:
        summary_text += f"• Time available: {summary['responses']['time']}\n"
    if 'equipment' in summary['responses']:
        summary_text += f"• Equipment: {summary['responses']['equipment']}\n"
    if summary['responses'].get('soreness'):
        summary_text += f"• Areas to work around: {summary['responses']['soreness']}\n"
    
    return {
        'type': 'interview',
        'status': 'complete',
        'message': summary_text,
        'question': {
            'id': 'permission',
            'question': "Ready for me to build your personalized workout?",
            'options': ['Yes, let\'s do it!', 'Actually, let me change something', 'Not right now'],
            'type': 'choice'
        },
        'summary': summary
    }

