rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isBlocked(targetUserId, currentUserId) {
      return exists(/databases/$(database)/documents/users/$(targetUserId)) &&
        get(/databases/$(database)/documents/users/$(targetUserId)).data.get('blockedUsers', []).hasAny([currentUserId]);
    }
    
    function isFollowing(targetUserId, currentUserId) {
      return exists(/databases/$(database)/documents/users/$(targetUserId)/followers/$(currentUserId));
    }
    
    function canViewProfile(targetUserId, currentUserId) {
      return currentUserId == targetUserId ||
        (get(/databases/$(database)/documents/users/$(targetUserId)).data.get('profileVisibility', 'public') == 'public') ||
        (get(/databases/$(database)/documents/users/$(targetUserId)).data.get('profileVisibility', 'public') == 'followers' && 
         isFollowing(targetUserId, currentUserId));
    }
    
    function canViewPost(postData, currentUserId) {
      return postData.authorId == currentUserId ||
        (postData.get('visibility', 'public') == 'public' && 
         !isBlocked(postData.authorId, currentUserId) && 
         !isBlocked(currentUserId, postData.authorId)) ||
        (postData.get('visibility', 'public') == 'followers' && 
         isFollowing(postData.authorId, currentUserId) &&
         !isBlocked(postData.authorId, currentUserId) && 
         !isBlocked(currentUserId, postData.authorId));
    }
    
    function canInteractWithPost(postData, currentUserId) {
      return canViewPost(postData, currentUserId);
    }

    // Users collection
    match /users/{userId} {
      // Read: any authenticated user. Profile visibility enforced client-side.
      // canViewProfile with get() calls was causing Firestore eval limits on bulk reads.
      allow read: if isAuthenticated();
      // Clients may not set Hype fields — written only by Cloud Functions (the
      // admin SDK bypasses rules). Leaving them unchanged in a diff is fine.
      allow create: if isOwner(userId)
        && !request.resource.data.keys().hasAny(['hypeByDay', 'hypeGiven']);
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['hypeByDay', 'hypeGiven']);

      // Allow clearing push tokens specifically (for logout cleanup)
      allow update: if isAuthenticated() && 
        isOwner(userId) && 
        resource.data.keys().hasAny(['pushTokens', 'lastTokenUpdate']) &&
        request.data.keys().hasOnly(['pushTokens', 'lastTokenUpdate']);
      
    }

    // Message requests
    match /users/{userId}/messageRequests/{requestId} {
      allow read, delete: if isOwner(userId);
      allow create: if isAuthenticated() && 
        request.auth.uid != userId && 
        !isBlocked(userId, request.auth.uid) &&
        !isBlocked(request.auth.uid, userId);
    }

    // User subcollections
    match /users/{userId}/followers/{followerId} {
      // get: owner or the follower themselves can read
      allow get: if isOwner(userId) || isOwner(followerId);
      // list: any authenticated user can list (for viewing profile follower counts/lists)
      allow list: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == followerId;
      allow delete: if isOwner(userId) || isOwner(followerId);
    }

    match /users/{userId}/following/{followedUserId} {
      // list: any authenticated user can list (for viewing who someone follows)
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    match /users/{userId}/followedTags/{tagName} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/pendingFollowers/{requesterId} {
      // Owner can read all pending, requester can check their own pending status
      allow read: if isOwner(userId) || isOwner(requesterId);
      allow create: if isAuthenticated() && request.auth.uid == requesterId;
      allow delete: if isOwner(userId) || isOwner(requesterId);
    }
    
    match /users/{userId}/savedWorkouts/{workoutId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/savedPosts/{postId} {
      allow read, write: if isOwner(userId);
    }

    // Feed state — per-user "seen" tracking (private to the user)
    match /users/{userId}/feedState/{docId} {
      allow read, write: if isOwner(userId);
    }
    
    // Workout Logs - User's completed workout sessions
    match /users/{userId}/workout_logs/{logId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && 
        request.resource.data.userId == userId &&
        request.resource.data.keys().hasAll(['userId', 'workoutName', 'startedAt', 'completedAt', 'exercises']);
      allow update: if isOwner(userId) && 
        resource.data.userId == userId;
      allow delete: if isOwner(userId);
    }
    
    // Exercise History - Per-exercise stats and personal records
    match /users/{userId}/exercise_history/{exerciseId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && 
        request.resource.data.userId == userId;
      allow update: if isOwner(userId) && 
        resource.data.userId == userId;
      allow delete: if isOwner(userId);
    }
    
    // Coach Insights - AI-generated post-workout analysis (written by Cloud Functions)
    match /users/{userId}/coach_insights/{insightId} {
      allow read: if isOwner(userId);
      allow create, update: if false;  // Only Cloud Functions (admin SDK) can write
      allow delete: if isOwner(userId);
    }

    // Coach Memory - AI-extracted observations about user (written by Cloud Run)
    match /users/{userId}/coach_memory/{memoryId} {
      allow read: if isOwner(userId);
      allow create, update, delete: if false;  // Only admin SDK (Cloud Run) writes
    }

    // AI Profile - dedicated AI coaching profile (written by Cloud Run)
    match /users/{userId}/ai_profile/{docId} {
      allow read: if isOwner(userId);
      allow write: if false;  // Only admin SDK writes
    }

    match /users/{userId}/conversations/{conversationId} {
      allow read: if isOwner(userId);
      allow write: if isAuthenticated();
    }

    match /users/{userId}/mentionBlocks/{blockedUid} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/suggestedUsers/{doc} {
      allow read: if isOwner(userId);
      allow write: if false; // only written by Cloud Functions (getSuggestedUsers)
    }

    match /users/{userId}/mentionBlockedBy/{blockerUid} {
      allow read: if isOwner(userId);
      allow write: if false; // only written by Cloud Functions (blockMentionUser)
    }

    // Usernames collection — intentionally public for username availability checks during signup
    match /usernames/{username} {
      allow read: if true;
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
    }

    // Posts collection
    match /posts/{postId} {
      allow read: if isAuthenticated();
      
      allow create: if isAuthenticated() && 
        request.auth.uid == request.resource.data.authorId &&
        request.resource.data.keys().hasAll(['authorId', 'createdAt']) &&
        request.resource.data.createdAt is timestamp;
      
      allow update: if isAuthenticated() && (
        (request.auth.uid == resource.data.authorId) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactionCount']) &&
          resource.data.get('visibility', 'public') == 'public'
        ) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactionCount']) &&
          resource.data.get('visibility', 'public') == 'followers' &&
          isFollowing(resource.data.authorId, request.auth.uid)
        )
      );
      
      allow delete: if isAuthenticated() && 
        request.auth.uid == resource.data.authorId;
      
      // Post subcollections
      match /likers/{userId} {
        allow read: if isAuthenticated();
        allow create, delete: if isAuthenticated() && request.auth.uid == userId;
      }
      
      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && 
          request.auth.uid == request.resource.data.authorId &&
          canInteractWithPost(get(/databases/$(database)/documents/posts/$(postId)).data, request.auth.uid) &&
          request.resource.data.keys().hasAll(['authorId', 'text', 'createdAt']) &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0;
        
        // Allow comment author to update/delete their own comment,
        // OR allow anyone who can interact with the post to update replyCount,
        // OR allow anyone who can interact with the post to update likes/likedBy for liking
        allow update: if isAuthenticated() && (
          (request.auth.uid == resource.data.authorId) ||
          (
            canInteractWithPost(get(/databases/$(database)/documents/posts/$(postId)).data, request.auth.uid) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount']) &&
            request.resource.data.replyCount == resource.data.replyCount + 1
          ) ||
          (
            canInteractWithPost(get(/databases/$(database)/documents/posts/$(postId)).data, request.auth.uid) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy'])
          )
        );
        
        allow delete: if isAuthenticated() && (
          request.auth.uid == resource.data.authorId ||
          request.auth.uid == get(/databases/$(database)/documents/posts/$(postId)).data.authorId
        );
        
        match /replies/{replyId} {
          allow read: if isAuthenticated();
          allow create: if isAuthenticated() && 
            request.auth.uid == request.resource.data.authorId &&
            canInteractWithPost(get(/databases/$(database)/documents/posts/$(postId)).data, request.auth.uid) &&
            request.resource.data.keys().hasAll(['authorId', 'text', 'createdAt', 'parentCommentId']) &&
            request.resource.data.text is string &&
            request.resource.data.text.size() > 0;
          allow update: if isAuthenticated() && (
            (request.auth.uid == resource.data.authorId) ||
            (
              canInteractWithPost(get(/databases/$(database)/documents/posts/$(postId)).data, request.auth.uid) &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy'])
            )
          );
          allow delete: if isAuthenticated() && (
            request.auth.uid == resource.data.authorId ||
            request.auth.uid == get(/databases/$(database)/documents/posts/$(postId)).data.authorId
          );
        }
      }
    }

    // Feeds collection
    match /feeds/{userId}/userFeed/{postId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Activity collection
    match /activity/{userId}/userActivity/{activityId} {
      allow read: if isOwner(userId);
      allow create: if isAuthenticated() && 
        request.resource.data.keys().hasAll(['type', 'fromUserId', 'fromUsername', 'createdAt']) &&
        request.auth.uid == request.resource.data.fromUserId;
      allow update: if false;
      allow delete: if isAuthenticated() && 
        request.auth.uid == resource.data.fromUserId;
    }

    // Workouts collection
    match /workouts/{workoutId} {
      // Authenticated users can read workouts (public, own, or saved)
      // Client-side filtering handles visibility; saves need access to other users' workouts
      allow read: if isAuthenticated();
      
      allow create: if isAuthenticated() && 
        request.auth.uid == request.resource.data.creatorId &&
        request.resource.data.keys().hasAll(['creatorId', 'title', 'createdAt']) &&
        request.resource.data.createdAt is timestamp;
      
      allow update: if isAuthenticated() && 
        request.auth.uid == resource.data.creatorId;
      
      // Allow any authenticated user to update savedCount (for save/unsave)
      allow update: if isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['savedCount']);
      
      allow delete: if isAuthenticated() && 
        request.auth.uid == resource.data.creatorId;
    }

    // Conversations collection
    match /conversations/{conversationId} {
      allow read: if isAuthenticated();
      
      allow create: if isAuthenticated() &&
        request.auth.uid in request.resource.data.participants &&
        (request.resource.data.participants.size() == 2 ||
         (request.resource.data.participants.size() == 1 && request.resource.data.isAiConversation == true));
      
      // Participants can update conversation metadata but NOT participants list or isAiConversation
      allow update: if isAuthenticated() &&
        request.auth.uid in resource.data.participants &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['participants', 'isAiConversation']);
      
      match /messages/{messageId} {
        // Read: participant check via parent doc. get() works for single reads;
        // list queries are scoped to conversations the user already has access to.
        allow read: if isAuthenticated();
        
        allow create: if isAuthenticated() &&
          request.auth.uid == request.resource.data.senderId &&
          request.resource.data.keys().hasAll(['senderId', 'text', 'createdAt']) &&
          request.resource.data.createdAt is timestamp;
        
        allow update, delete: if isAuthenticated() && 
          request.auth.uid == resource.data.senderId;
      }
    }

    // Milestones collection — public achievements
    match /milestones/{milestoneId} {
      // get: block check on single doc reads
      allow get: if isAuthenticated() &&
        !isBlocked(resource.data.authorId, request.auth.uid) &&
        !isBlocked(request.auth.uid, resource.data.authorId);
      // list: authenticated — block filtering done client-side
      allow list: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.auth.uid == request.resource.data.authorId;
      allow update: if isAuthenticated() &&
        request.auth.uid == resource.data.authorId;
      allow delete: if isAuthenticated() &&
        request.auth.uid == resource.data.authorId;
    }

    // Notification logs — server-side only (rate limiting). Admin SDK bypasses rules.
    match /notificationLogs/{logId} {
      allow read, write: if false;
    }

    // Analytics collection — append-only, no reads from client
    match /analytics/{document} {
      allow read: if false;
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // usersPublic collection: readable by unauthenticated users for username existence check
    match /usersPublic/{userId} {
      allow read: if true; // Anyone can read for username existence check
      allow create, update: if isOwner(userId); // Only authenticated user can create/update their own doc
    }


    // Reports collection
    match /reports/{reportId} {
      // Users can only read reports they filed
      allow read: if isAuthenticated() &&
        resource.data.reporters[0].userId == request.auth.uid;

      // Users can create reports (first reporter must be the caller)
      allow create: if isAuthenticated() &&
        request.resource.data.reporters[0].userId == request.auth.uid;

      // Users can update reports to add themselves as a reporter
      // Only the reporters array can change, new entry must belong to caller
      allow update: if isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reporters']) &&
        request.resource.data.reporters.size() > resource.data.reporters.size() &&
        request.resource.data.reporters[request.resource.data.reporters.size() - 1].userId == request.auth.uid;

      // Admin operations (read all, update status) use Cloud Functions with Admin SDK
      allow delete: if false;
    }

    // Hashtags collection — any authenticated user can read; only Cloud Functions (Admin SDK) write
    match /hashtags/{tagName} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
  }
}