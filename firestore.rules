rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isBlocked(targetUserId, currentUserId) {
      return exists(/databases/$(database)/documents/users/$(targetUserId)) &&
        get(/databases/$(database)/documents/users/$(targetUserId)).data.get('blockedUsers', []).hasAny([currentUserId]);
    }
    
    function isFollowing(targetUserId, currentUserId) {
      return exists(/databases/$(database)/documents/users/$(targetUserId)/followers/$(currentUserId));
    }
    
    function canViewProfile(targetUserId, currentUserId) {
      return currentUserId == targetUserId ||
        (get(/databases/$(database)/documents/users/$(targetUserId)).data.get('profileVisibility', 'public') == 'public') ||
        (get(/databases/$(database)/documents/users/$(targetUserId)).data.get('profileVisibility', 'public') == 'followers' && 
         isFollowing(targetUserId, currentUserId));
    }
    
    function canViewPost(postData, currentUserId) {
      return postData.authorId == currentUserId ||
        (postData.get('visibility', 'public') == 'public' && 
         !isBlocked(postData.authorId, currentUserId) && 
         !isBlocked(currentUserId, postData.authorId)) ||
        (postData.get('visibility', 'public') == 'followers' && 
         isFollowing(postData.authorId, currentUserId) &&
         !isBlocked(postData.authorId, currentUserId) && 
         !isBlocked(currentUserId, postData.authorId));
    }
    
    function canInteractWithPost(postData, currentUserId) {
      return canViewPost(postData, currentUserId);
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated() && 
        (isOwner(userId) || canViewProfile(userId, request.auth.uid));
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      
      // Allow clearing push tokens specifically (for logout cleanup)
      allow update: if isAuthenticated() && 
        isOwner(userId) && 
        resource.data.keys().hasAny(['pushTokens', 'lastTokenUpdate']) &&
        request.data.keys().hasOnly(['pushTokens', 'lastTokenUpdate']);
      
      // Allow admin dashboard to read/update users for moderation (localhost only)
      // TODO: Replace with proper admin auth in production
      allow read, update: if true;
    }

    // Message requests
    match /users/{userId}/messageRequests/{requestId} {
      allow read, delete: if isOwner(userId);
      allow create: if isAuthenticated() && 
        request.auth.uid != userId && 
        !isBlocked(userId, request.auth.uid) &&
        !isBlocked(request.auth.uid, userId);
    }

    // User subcollections
    match /users/{userId}/followers/{followerId} {
      allow read: if isOwner(userId) || isOwner(followerId);
      allow create: if isAuthenticated() && request.auth.uid == followerId;
      allow delete: if isOwner(userId) || isOwner(followerId);
    }
    
    match /users/{userId}/following/{followedUserId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }
    
    match /users/{userId}/pendingFollowers/{requesterId} {
      allow read: if isOwner(userId);
      allow create: if isAuthenticated() && request.auth.uid == requesterId;
      allow delete: if isOwner(userId) || isOwner(requesterId);
    }
    
    match /users/{userId}/savedWorkouts/{workoutId} {
      allow read, write: if isOwner(userId);
    }
    
    // Workout Logs - User's completed workout sessions
    match /users/{userId}/workout_logs/{logId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && 
        request.resource.data.userId == userId &&
        request.resource.data.keys().hasAll(['userId', 'workoutName', 'startedAt', 'completedAt', 'exercises']);
      allow update: if isOwner(userId) && 
        resource.data.userId == userId;
      allow delete: if isOwner(userId);
    }
    
    // Exercise History - Per-exercise stats and personal records
    match /users/{userId}/exercise_history/{exerciseId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && 
        request.resource.data.userId == userId;
      allow update: if isOwner(userId) && 
        resource.data.userId == userId;
      allow delete: if isOwner(userId);
    }
    
    match /users/{userId}/conversations/{conversationId} {
      allow read: if isOwner(userId);
      allow write: if isAuthenticated() &&
        get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants.hasAny([request.auth.uid]);
    }

    // Usernames collection
    match /usernames/{username} {
      allow read: if true;
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
    }

    // Posts collection
    match /posts/{postId} {
      // Allow thumbnail optimization reads
      allow get: if request.resource.data.keys().hasAny(['thumbnailUrl']);
      allow read: if isAuthenticated() && 
        canViewPost(resource.data, request.auth.uid);
      
      allow create: if isAuthenticated() && 
        request.auth.uid == request.resource.data.authorId &&
        request.resource.data.keys().hasAll(['authorId', 'createdAt']) &&
        request.resource.data.createdAt is timestamp;
      
      allow update: if isAuthenticated() && (
        (request.auth.uid == resource.data.authorId) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactionCount']) &&
          resource.data.get('visibility', 'public') == 'public'
        ) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactionCount']) &&
          resource.data.get('visibility', 'public') == 'followers' &&
          isFollowing(resource.data.authorId, request.auth.uid)
        )
      );
      
      allow delete: if isAuthenticated() && 
        request.auth.uid == resource.data.authorId;
      
      // Post subcollections
      match /likers/{userId} {
        allow read: if isAuthenticated();
        allow create, delete: if isAuthenticated() && request.auth.uid == userId;
      }
      
      match /comments/{commentId} {
        allow read: if isAuthenticated() && 
          canViewPost(get(/databases/$(database)/documents/posts/$(postId)).data, request.auth.uid);
        allow create: if isAuthenticated() && 
          request.auth.uid == request.resource.data.authorId &&
          canInteractWithPost(get(/databases/$(database)/documents/posts/$(postId)).data, request.auth.uid) &&
          request.resource.data.keys().hasAll(['authorId', 'text', 'createdAt']) &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0;
        
        // Allow comment author to update/delete their own comment,
        // OR allow anyone who can interact with the post to update replyCount,
        // OR allow anyone who can interact with the post to update likes/likedBy for liking
        allow update: if isAuthenticated() && (
          (request.auth.uid == resource.data.authorId) ||
          (
            canInteractWithPost(get(/databases/$(database)/documents/posts/$(postId)).data, request.auth.uid) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount']) &&
            request.resource.data.replyCount == resource.data.replyCount + 1
          ) ||
          (
            canInteractWithPost(get(/databases/$(database)/documents/posts/$(postId)).data, request.auth.uid) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy'])
          )
        );
        
        allow delete: if isAuthenticated() && (
          request.auth.uid == resource.data.authorId ||
          request.auth.uid == get(/databases/$(database)/documents/posts/$(postId)).data.authorId
        );
        
        match /replies/{replyId} {
          allow read: if isAuthenticated();
          allow create: if isAuthenticated() && 
            request.auth.uid == request.resource.data.authorId &&
            canInteractWithPost(get(/databases/$(database)/documents/posts/$(postId)).data, request.auth.uid) &&
            request.resource.data.keys().hasAll(['authorId', 'text', 'createdAt', 'parentCommentId']) &&
            request.resource.data.text is string &&
            request.resource.data.text.size() > 0;
          allow update: if isAuthenticated() && (
            (request.auth.uid == resource.data.authorId) ||
            (
              canInteractWithPost(get(/databases/$(database)/documents/posts/$(postId)).data, request.auth.uid) &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy'])
            )
          );
          allow delete: if isAuthenticated() && (
            request.auth.uid == resource.data.authorId ||
            request.auth.uid == get(/databases/$(database)/documents/posts/$(postId)).data.authorId
          );
        }
      }
    }

    // Feeds collection
    match /feeds/{userId}/userFeed/{postId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Activity collection
    match /activity/{userId}/userActivity/{activityId} {
      allow read: if isOwner(userId);
      allow create: if isAuthenticated() && 
        request.resource.data.keys().hasAll(['type', 'fromUserId', 'fromUsername', 'createdAt']) &&
        request.auth.uid == request.resource.data.fromUserId;
      allow update: if false;
      allow delete: if isAuthenticated() && 
        request.auth.uid == resource.data.fromUserId;
    }

    // Workouts collection
    match /workouts/{workoutId} {
      // Allow thumbnail optimization reads
      allow get: if request.resource.data.keys().hasAny(['thumbnailUrl']);
      allow read: if isAuthenticated() && 
        (resource.data.get('isPublic', false) == true || 
         resource.data.creatorId == request.auth.uid);
      
      allow create: if isAuthenticated() && 
        request.auth.uid == request.resource.data.creatorId &&
        request.resource.data.keys().hasAll(['creatorId', 'title', 'createdAt']) &&
        request.resource.data.createdAt is timestamp;
      
      allow update: if isAuthenticated() && 
        request.auth.uid == resource.data.creatorId;
      
      // Allow any authenticated user to update savedCount (for save/unsave)
      allow update: if isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['savedCount']);
      
      allow delete: if isAuthenticated() && 
        request.auth.uid == resource.data.creatorId;
    }

    // Conversations collection
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && 
        request.auth.uid in resource.data.participants;
      
      allow create: if isAuthenticated() &&
        request.auth.uid in request.resource.data.participants &&
        (request.resource.data.participants.size() == 2 ||
         (request.resource.data.participants.size() == 1 && request.resource.data.isAiConversation == true));
      
      allow update: if isAuthenticated() && 
        request.auth.uid in resource.data.participants;
      
      match /messages/{messageId} {
        allow read: if isAuthenticated() && 
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        
        allow create: if isAuthenticated() && 
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants &&
          request.auth.uid == request.resource.data.senderId &&
          request.resource.data.keys().hasAll(['senderId', 'text', 'createdAt']) &&
          request.resource.data.createdAt is timestamp;
        
        allow update, delete: if isAuthenticated() && 
          request.auth.uid == resource.data.senderId;
      }
    }

    // Milestones collection
    match /milestones/{milestoneId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.auth.uid == request.resource.data.authorId;
      allow update: if isAuthenticated() &&
        request.auth.uid == resource.data.authorId;
      allow delete: if isAuthenticated() &&
        request.auth.uid == resource.data.authorId;
    }

    // Temporary fallback rule for debugging
    match /{document=**} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Analytics collection
    match /analytics/{document} {
      allow read: if false;
      allow write: if isAuthenticated();
    }

    // usersPublic collection: readable by unauthenticated users for username existence check
    match /usersPublic/{userId} {
      allow read: if true; // Anyone can read for username existence check
      allow create, update: if isOwner(userId); // Only authenticated user can create/update their own doc
    }


    // Reports collection
    match /reports/{reportId} {
      // Allow unauthenticated reads for admin dashboard (localhost only)
      // TODO: Remove this and use proper admin auth in production
      allow read: if true;
      
      // Users can create reports (service handles the logic)
      allow create: if isAuthenticated() && 
        request.resource.data.reporters[0].userId == request.auth.uid;
      
      // Users can update reports to add themselves as a reporter
      allow update: if isAuthenticated() && 
        request.resource.data.reporters.size() > resource.data.reporters.size();
      
      // Allow admin dashboard to update reports (for taking actions)
      // TODO: Replace with proper admin auth in production
      allow update: if true;
      
      // Only admins can delete (handled server-side)
      allow delete: if false;
    }
  }
}