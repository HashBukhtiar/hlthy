rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow authenticated users to write to their own workoutCovers folder
    match /workoutCovers/{userId}/{filename} {
      allow write: if request.auth != null && request.auth.uid == userId;
      allow read: if true; // Public read access for workout covers
    }
    // Allow public read for profile images (optional)
    match /profileImages/{userId}/{filename} {
      allow write: if request.auth != null && request.auth.uid == userId;
      allow read: if true;
    }
    // Allow authenticated users to write to their own posts folder
    match /posts/{userId}/{filename} {
      // On delete, request.resource is null, so the size/content-type checks
      // must be guarded — otherwise the owner can upload but never delete.
      allow write: if request.auth != null
        && request.auth.uid == userId
        && (
          request.resource == null
          || (
            request.resource.size <= 50 * 1024 * 1024
            && (request.resource.contentType == 'image/jpeg'
              || request.resource.contentType == 'video/mp4'
              || request.resource.contentType == 'video/quicktime')
          )
        );
      allow read: if true; // Public read access for post images
    }
    // Allow conversation participants to upload/read photos in their conversations
    match /conversations/{conversationId}/photos/{photoId}/{filename} {
      allow write: if request.auth != null && 
        firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.participants.hasAny([request.auth.uid]);
      allow read: if request.auth != null && 
        firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.participants.hasAny([request.auth.uid]);
    }
    // Default: deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}